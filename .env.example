LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VERIFIER_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=300

# Search API tuning. count is results per request (1-50); per_query is how many
# keyword queries the planner may emit for one configured research brief.
DEEPSEEK_SEARCH_COUNT=10
DEEPSEEK_SEARCH_PER_QUERY=3
DEEPSEEK_SEARCH_NEED_CONTENT=false
DEEPSEEK_SEARCH_CONCURRENCY=4
DEEPSEEK_SEARCH_DATE_FILTER=true
DEEPSEEK_RESULTS_PER_QUERY=10
DEEPSEEK_VERIFY_SEARCH_TOP_N=6
DEEPSEEK_MAX_RAW_ITEMS_PER_CALL=120
DEEPSEEK_RAW_ITEM_CHARS=2500

TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite:///data/inforp.db
INCIDENT_LOG_FILE=logs/automation_incidents.jsonl

REPORT_OUTPUT_DIR=reports
SOURCES_FILE=configs/sources.yaml
RECIPIENTS_FILE=configs/recipients.yaml
MAX_DAILY_READ_MINUTES=5
# Report body caps: the database keeps every ranked event, the email does not.
MAX_REPORT_EVENTS=15
MAX_WEEKLY_REPORT_EVENTS=25
MAX_WATCHLIST_EVENTS=8
# Important-but-contested stories stay in the body instead of being parked on the watchlist.
WATCHLIST_PROMOTE_IMPORTANCE=0.85

# Set to 1 to make every outbound channel a no-op (email, WeCom, weekly WeCom summary).
# Reports are still written to REPORT_OUTPUT_DIR. `inforp run-daily --dry-run` sets this.
# INFORP_NO_OUTBOUND=1

# Fixed-source collection: parallel fetch, 48h window, per-source cap.
COLLECT_CONCURRENCY=8
COLLECT_LOOKBACK_HOURS=48
COLLECT_MAX_ITEMS_PER_SOURCE=20

DELIVERY_CHANNELS=local_file

WECOM_WEBHOOK_URL=
# Keep this false until you have tested the summary text. This switch alone controls the
# weekly WeCom group message: it ignores DELIVERY_CHANNELS, and a sent message cannot be recalled.
WECOM_WEEKLY_SUMMARY_ENABLED=false
WECOM_WEEKLY_SUMMARY_TOP_ITEMS=5

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: store a copy of each sent report in the IMAP "Sent" folder.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# IMAP_SENT_MAILBOX=
EMAIL_FROM=
EMAIL_TO=
# Optional: switch automated email delivery from EMAIL_TO to an active recipient set.
# EMAIL_RECIPIENT_SET=company_colleagues

ENABLE_LLM=true
ENABLE_BROWSER_CONNECTORS=false
TOKEN_BUDGET_DAILY=
TOKEN_BUDGET_WEEKLY=
